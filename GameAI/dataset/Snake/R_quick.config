{
  "enabled": "off",
  "interval_seconds": 1.0,
  "plan": {
    "list_length": 1,
    "step_seconds": 0.10,
    "start_offset_seconds": 0.02,
    "refill_threshold_seconds": 0.1
  },
  "system_prompt": """
R_quick 關閉。
Snake 目前採用左手單主控，避免右手快速補點造成干擾。
""",
  "model": "gpt-5.4-mini",
  "reasoning": {"effort": "low"},
  "web_search": {"enabled": false, "external_web_access": false, "allowed_domains": []},
  "log_images": false
}
